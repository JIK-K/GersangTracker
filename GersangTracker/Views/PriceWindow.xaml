<Window x:Class="GersangTracker.Views.PriceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="가격 입력" Height="500" Width="500"
        Background="#222831"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- 상단 헤더 -->
        <Border Grid.Row="0" Background="#393E46">
            <Grid Margin="16,0">
                <TextBlock Text="가격 입력"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding MonsterName}"
                           Foreground="#00ADB5"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- 컬럼 헤더 -->
        <Grid Grid.Row="1" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="아이템명"
                       Foreground="#EEEEEE"
                       Opacity="0.6"
                       FontSize="11"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="수량"
                       Foreground="#EEEEEE"
                       Opacity="0.6"
                       FontSize="11"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2"
                       Text="단가 (원)"
                       Foreground="#EEEEEE"
                       Opacity="0.6"
                       FontSize="11"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Grid>

        <!-- 아이템 목록 -->
        <ScrollViewer Grid.Row="2" Margin="8,0">
            <ItemsControl ItemsSource="{Binding PriceItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#393E46"
                                CornerRadius="4"
                                Margin="8,4"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <!-- 아이템명 -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding ItemName}"
                                           Foreground="White"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                <!-- 수량 -->
                                <TextBlock Grid.Column="1"
                                           Foreground="#EEEEEE"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center">
                                    <Run Text="{Binding TotalQuantity}"/>
                                    <Run Text="개"/>
                                </TextBlock>

                                <!-- 단가 입력 -->
                                <TextBox Grid.Column="2"
                                         Text="{Binding UnitPriceInput, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#222831"
                                         Foreground="White"
                                         BorderThickness="0"
                                         CaretBrush="White"
                                         FontSize="12"
                                         Padding="8,4"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Right">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 하단 버튼 -->
        <Border Grid.Row="3" Background="#393E46">
            <Button Content="계산하기"
                    Width="160"
                    Height="36"
                    Background="#00ADB5"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontSize="13"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="CalculateButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
    </Grid>
</Window>