<Window x:Class="GersangTracker.Views.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="세션 목록" Height="540" Width="620"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Border Background="#222831" CornerRadius="10"
            BorderBrush="#393E46" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="20" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 커스텀 타이틀바 -->
            <Border Grid.Row="0" Background="#222831" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#00ADB5" Margin="0,0,8,0"/>
                        <TextBlock Text="세션 목록" Foreground="White" FontSize="13"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Width="40" Height="32" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="MinimizeButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                        <Path Data="M 8,12 L 24,12" Stroke="#EEEEEE" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#393E46"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="40" Height="32" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                        <Path Data="M 8,8 L 22,22 M 22,8 L 8,22" Stroke="#EEEEEE" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#C0392B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 헤더 -->
            <Border Grid.Row="1" Background="#393E46" Margin="12,0,12,0" CornerRadius="6">
                <Grid Margin="16,0">
                    <TextBlock Text="세션 목록" Foreground="White" FontSize="15"
                               FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MonsterName}" Foreground="#00ADB5"
                               FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- 컬럼 헤더 -->
            <Grid Grid.Row="2" Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="날짜" Foreground="#EEEEEE"
                           Opacity="0.5" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="사냥 시간" Foreground="#EEEEEE"
                           Opacity="0.5" FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="총 수익" Foreground="#EEEEEE"
                           Opacity="0.5" FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- 세션 목록 -->
            <ScrollViewer Grid.Row="3" Margin="8,0,8,8">
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#393E46" CornerRadius="6" Margin="8,3" Padding="12,10"
                                    Cursor="Hand" MouseLeftButtonDown="Session_MouseLeftButtonDown">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                               Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding HuntingTimeDisplay}"
                                               Foreground="#EEEEEE" FontSize="12"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TotalProfit, StringFormat={}{0:N0} 원}"
                                               Foreground="#00ADB5" FontSize="12" FontWeight="Bold"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <Button Grid.Column="3" Content="삭제"
                                            Background="#C0392B" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"
                                            FontSize="11" Padding="8,4" HorizontalAlignment="Center"
                                            Command="{Binding DataContext.DeleteSessionCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>