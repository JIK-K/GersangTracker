<Window x:Class="GersangTracker.Views.PriceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="가격 입력" Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AnimatedWindowStyle}">

    <Border Background="{StaticResource BackgroundSecondary}" CornerRadius="12"
            BorderBrush="{StaticResource BackgroundTertiary}" BorderThickness="1">
        <Border.Effect>
            <StaticResource ResourceKey="SoftDropShadow"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="56"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <!-- 커스텀 타이틀바 -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundSecondary}" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="가격 입력" Foreground="{StaticResource TextPrimary}" FontSize="13"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click">
                            <Path Data="M 8,12 L 24,12" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click">
                            <Path Data="M 8,8 L 22,22 M 22,8 L 8,22" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 헤더 -->
            <Border Grid.Row="1" Background="{StaticResource BackgroundTertiary}" Margin="12,0,12,0" CornerRadius="8">
                <Grid Margin="16,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="가격 입력" Foreground="{StaticResource TextPrimary}" FontSize="15"
                                   FontWeight="Bold"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="{StaticResource BackgroundPrimary}"
                            CornerRadius="5" Padding="10,4">
                        <TextBlock Text="{Binding MonsterName}" Foreground="{StaticResource AccentColor}"
                                   FontSize="13" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 컬럼 헤더 -->
            <Grid Grid.Row="2" Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="아이템명" Style="{StaticResource SectionHeaderLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="수량" Style="{StaticResource SectionHeaderLabel}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="단가 (원)" Style="{StaticResource SectionHeaderLabel}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

            <!-- 아이템 목록 -->
            <ScrollViewer Grid.Row="3" Margin="8,0">
                <ItemsControl ItemsSource="{Binding PriceItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="itemRow"
                                    Background="{StaticResource BackgroundTertiary}"
                                    CornerRadius="6" Margin="8,3" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ItemName}"
                                               Foreground="{StaticResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding TotalQuantity, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{StaticResource BackgroundPrimary}"
                                             Foreground="{StaticResource TextPrimary}"
                                             BorderThickness="0"
                                             CaretBrush="{StaticResource TextPrimary}"
                                             FontSize="12" Padding="4"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Center">
                                        <TextBox.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding UnitPriceInput, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{StaticResource BackgroundPrimary}"
                                             Foreground="{StaticResource TextPrimary}"
                                             BorderThickness="0"
                                             CaretBrush="{StaticResource TextPrimary}"
                                             FontSize="12" Padding="8,4"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Right">
                                        <TextBox.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                    <Button Grid.Column="3"
                                            Command="{Binding DataContext.RemoveItemCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TitleBarButton}"
                                            Foreground="{StaticResource DangerColor}"
                                            FontSize="12" Padding="4">
                                        <iconPacks:PackIconMaterial Kind="Close"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 아이템 추가 -->
            <Grid Grid.Row="4" Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,0,8,0"
                         Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource BackgroundTertiary}"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource AccentColor}" BorderThickness="1"
                         CaretBrush="{StaticResource TextPrimary}" Padding="8,6" FontSize="12"
                         VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </TextBox.Resources>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddItemCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBox Grid.Column="1" Margin="0,0,8,0"
                         Text="{Binding NewItemQuantity, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource BackgroundTertiary}"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource AccentColor}" BorderThickness="1"
                         CaretBrush="{StaticResource TextPrimary}" Padding="6,6" FontSize="12"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </TextBox.Resources>
                </TextBox>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddItemCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="추가"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 계산하기 버튼 -->
            <Border Grid.Row="5" Background="{StaticResource BackgroundTertiary}" CornerRadius="0,0,12,12"
                    BorderBrush="{StaticResource SeparatorColor}" BorderThickness="0,1,0,0">
                <Button Style="{StaticResource PrimaryButton}"
                        Width="160" Height="36"
                        FontSize="13"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Click="CalculateButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Calculator" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="계산하기"/>
                    </StackPanel>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>