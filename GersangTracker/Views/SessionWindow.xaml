<Window x:Class="GersangTracker.Views.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="세션 목록" Height="500" Width="600"
        Background="#222831"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 헤더 -->
        <Border Grid.Row="0" Background="#393E46">
            <Grid Margin="16,0">
                <TextBlock Text="세션 목록"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding MonsterName}"
                           Foreground="#00ADB5"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- 컬럼 헤더 -->
        <Grid Grid.Row="1" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="날짜"
                       Foreground="#EEEEEE"
                       Opacity="0.6"
                       FontSize="11"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="사냥 시간"
                       Foreground="#EEEEEE"
                       Opacity="0.6"
                       FontSize="11"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2"
                       Text="총 수익"
                       Foreground="#EEEEEE"
                       Opacity="0.6"
                       FontSize="11"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="3"
                       Text=""
                       Foreground="#EEEEEE"
                       Opacity="0.6"
                       FontSize="11"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- 세션 목록 -->
        <ScrollViewer Grid.Row="2" Margin="8,0">
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#393E46"
                                CornerRadius="4"
                                Margin="8,4"
                                Padding="12,10"
                                Cursor="Hand"
                                MouseLeftButtonDown="Session_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>

                                <!-- 날짜 -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           Foreground="White"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                <!-- 사냥 시간 -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding HuntingTimeDisplay}"
                                           Foreground="#EEEEEE"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>

                                <!-- 총 수익 -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding TotalProfit, StringFormat={}{0:N0} 원}"
                                           Foreground="#00ADB5"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>

                                <!-- 삭제 버튼 -->
                                <Button Grid.Column="3"
                                        Content="삭제"
                                        Background="#C0392B"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        FontSize="11"
                                        Padding="8,4"
                                        HorizontalAlignment="Center"
                                        Command="{Binding DataContext.DeleteSessionCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>