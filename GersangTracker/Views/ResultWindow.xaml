<Window x:Class="GersangTracker.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="사냥 결과" Height="660" Width="560"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AnimatedWindowStyle}">

    <Border Background="{StaticResource BackgroundSecondary}" CornerRadius="12"
            BorderBrush="{StaticResource BackgroundTertiary}" BorderThickness="1">
        <Border.Effect>
            <StaticResource ResourceKey="SoftDropShadow"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="56"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="118"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <!-- 커스텀 타이틀바 -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundSecondary}" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="사냥 결과" Foreground="{StaticResource TextPrimary}" FontSize="13"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click">
                            <Path Data="M 8,12 L 24,12" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click">
                            <Path Data="M 8,8 L 22,22 M 22,8 L 8,22" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 헤더 -->
            <Border Grid.Row="1" Background="{StaticResource BackgroundTertiary}" Margin="12,0,12,0" CornerRadius="8">
                <Grid Margin="16,0">
                    <TextBlock Text="사냥 결과" Foreground="{StaticResource TextPrimary}" FontSize="15"
                               FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="{StaticResource BackgroundPrimary}"
                            CornerRadius="5" Padding="10,4">
                        <TextBlock Text="{Binding MonsterName}" Foreground="{StaticResource AccentColor}"
                                   FontSize="13" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 컬럼 헤더 -->
            <Grid Grid.Row="2" Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="아이템명" Style="{StaticResource SectionHeaderLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="수량" Style="{StaticResource SectionHeaderLabel}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="단가" Style="{StaticResource SectionHeaderLabel}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="합계" Style="{StaticResource SectionHeaderLabel}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <!-- 아이템 목록 -->
            <ScrollViewer Grid.Row="3" Margin="8,0">
                <ItemsControl ItemsSource="{Binding PriceItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BackgroundTertiary}"
                                    CornerRadius="6" Margin="8,3" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ItemName}"
                                               Foreground="{StaticResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Foreground="{StaticResource TextSecondary}" FontSize="12"
                                               VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Run Text="{Binding TotalQuantity}"/><Run Text="개"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                               Foreground="{StaticResource TextSecondary}" FontSize="12"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Total, StringFormat={}{0:N0}}"
                                               Foreground="{StaticResource AccentColor}" FontSize="12" FontWeight="Bold"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 수익 요약 카드 (재디자인) -->
            <Border Grid.Row="4" Margin="12,4" CornerRadius="10"
                    Background="{StaticResource BackgroundPrimary}">
                <Grid Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 좌측: 총 수익 + 사냥 시간 -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <!-- 총 수익 -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="총 수익" Style="{StaticResource SectionHeaderLabel}" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding TotalProfit, StringFormat={}{0:N0} 원}"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        <!-- 사냥 시간 -->
                        <StackPanel>
                            <TextBlock Text="사냥 시간" Style="{StaticResource SectionHeaderLabel}" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding HuntingTime}"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle Grid.Column="1" Fill="{StaticResource SeparatorColor}" Width="1"/>

                    <!-- 우측: 시간당 수익 하이라이트 -->
                    <Border Grid.Column="2" Background="{StaticResource AccentGradient}"
                            CornerRadius="8" Margin="16,0,0,0"
                            Padding="14,12">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                <iconPacks:PackIconMaterial Kind="TrendingUp" Width="13" Height="13"
                                                            Foreground="White" Opacity="0.85"
                                                            Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="시간당 수익"
                                           Foreground="White" Opacity="0.85"
                                           FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ProfitPerHour, StringFormat={}{0:N0}}"
                                       Foreground="White" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="원 / h"
                                       Foreground="White" Opacity="0.8"
                                       FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 하단 버튼 -->
            <Border Grid.Row="5" Background="{StaticResource BackgroundTertiary}" CornerRadius="0,0,12,12"
                    BorderBrush="{StaticResource SeparatorColor}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}"
                            Width="140" Height="36"
                            FontSize="12" Margin="0,0,10,0"
                            Command="{Binding ExportExcelCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="FileExcel" Width="14" Height="14" Margin="0,0,6,0" Foreground="{StaticResource AccentColor}"/>
                            <TextBlock Text="엑셀 내보내기"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}"
                            Width="140" Height="36"
                            FontSize="12"
                            Click="ConfirmButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="확인"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>