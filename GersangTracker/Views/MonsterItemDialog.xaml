<!-- Views/MonsterItemDialog.xaml -->
<Window x:Class="GersangTracker.Views.MonsterItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="드랍 아이템 관리" Height="440" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource AnimatedWindowStyle}">

    <Border Background="{StaticResource BackgroundSecondary}" CornerRadius="12"
            BorderBrush="{StaticResource BackgroundTertiary}" BorderThickness="1">
        <Border.Effect>
            <StaticResource ResourceKey="SoftDropShadow"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 커스텀 타이틀바 -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundSecondary}" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="드랍 아이템 관리" Foreground="{StaticResource TextPrimary}" FontSize="13"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                            Click="CloseButton_Click">
                        <Path Data="M 8,8 L 22,22 M 22,8 L 8,22" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 입력부 -->
            <Grid Grid.Row="1" Margin="16,12,16,8">
                <!-- 섹션 레이블 -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding MonsterName, StringFormat='{}{0} — 드랍 아이템'}"
                           Foreground="{StaticResource AccentColor}"
                           FontSize="13" FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                             Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             x:Name="ItemInput">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddItemCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddItemCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="추가"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
 
            <!-- 아이템 목록 -->
            <Border Grid.Row="2" Background="{StaticResource BackgroundPrimary}"
                    Margin="16,0,16,0" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                    <ItemsControl ItemsSource="{Binding Items}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="itemRow"
                                        Background="Transparent"
                                        CornerRadius="6" Margin="0,2" Padding="10,8"
                                        BorderBrush="{StaticResource SeparatorColor}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ItemName}"
                                                   Foreground="{StaticResource TextPrimary}" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource TitleBarButton}"
                                                Width="28" Height="28"
                                                Command="{Binding DataContext.DeleteItemCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <iconPacks:PackIconMaterial Kind="Close" Width="10" Height="10"
                                                                        Foreground="{StaticResource DangerColor}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="itemRow" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="itemRow" Property="Background" Value="{StaticResource GlassOverlay}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 닫기 버튼 -->
            <Border Grid.Row="3" Padding="16,12"
                    BorderBrush="{StaticResource SeparatorColor}" BorderThickness="0,1,0,0">
                <Button Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right"
                        Click="CloseButton_Click">
                    <TextBlock Text="닫기"/>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>