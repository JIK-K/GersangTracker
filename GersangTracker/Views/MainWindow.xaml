<Window x:Class="GersangTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GersangTracker.ViewModels"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="GersangTracker" Height="700" Width="1000"
        Style="{StaticResource AnimatedWindowStyle}">

    <Border Background="{StaticResource BackgroundPrimary}" CornerRadius="12"
            BorderBrush="{StaticResource BackgroundSecondary}" BorderThickness="1">
        <Border.Effect>
            <StaticResource ResourceKey="SoftDropShadow"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 커스텀 타이틀바 -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundSecondary}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#00ADB5" Margin="0,0,8,0"/>
                        <TextBlock Text="GersangTracker"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- 최소화 -->
                        <Button Style="{StaticResource TitleBarButton}"
                                Click="MinimizeButton_Click">
                            <Path Data="M 8,12 L 24,12" Stroke="#EEEEEE" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <!-- 닫기 -->
                        <Button Style="{StaticResource TitleBarButton}"
                                Click="CloseButton_Click">
                            <Path Data="M 8,8 L 22,22 M 22,8 L 8,22"
                                  Stroke="#EEEEEE" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 메인 레이아웃 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 사이드바 -->
                <Border Grid.Column="0" Background="{StaticResource BackgroundSecondary}"
                        CornerRadius="0,0,0,12">
                    <StackPanel Margin="16">
                        <TextBlock Text="몬스터 추가"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" FontWeight="Bold"
                                   Margin="0,16,0,8"/>
                        <TextBox Height="38"
                                 Padding="10,8"
                                 Background="{StaticResource BackgroundPrimary}"
                                 Foreground="{StaticResource TextPrimary}"
                                 BorderThickness="1"
                                 BorderBrush="{StaticResource BackgroundTertiary}"
                                 CaretBrush="{StaticResource TextPrimary}"
                                 Text="{Binding NewMonsterName, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,12">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddMonsterCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Style="{StaticResource SidebarButton}"
                                Command="{Binding AddMonsterCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="추가"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 메인 컨텐츠 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BackgroundPrimary}" Padding="24,0,0,0">
                        <TextBlock Text="몬스터 목록"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" Margin="16">
                        <ItemsControl ItemsSource="{Binding Monsters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="220" Margin="10"
                                            Background="{StaticResource BackgroundSecondary}"
                                            CornerRadius="12">
                                        <Border.Effect>
                                            <StaticResource ResourceKey="SoftDropShadow"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="{StaticResource AccentGradient}"
                                                    CornerRadius="12,12,0,0"
                                                    Padding="16,14">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="White"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"/>
                                            </Border>

                                            <StackPanel Grid.Row="1" Margin="12,12,12,4">
                                                <Button Style="{StaticResource PrimaryButton}"
                                                        HorizontalAlignment="Stretch"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Padding="10,9"
                                                        Margin="0,0,0,6"
                                                        Command="{Binding DataContext.StartHuntingCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <iconPacks:PackIconMaterial Kind="SwordCross" Width="14" Height="14" Margin="0,0,6,0"/>
                                                        <TextBlock Text="사냥 시작"/>
                                                    </StackPanel>
                                                </Button>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource SecondaryButton}"
                                                            HorizontalAlignment="Stretch"
                                                            Command="{Binding DataContext.ManageItemsCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <iconPacks:PackIconMaterial Kind="PackageVariant" Width="12" Height="12" Margin="0,0,4,0" Foreground="{StaticResource AccentColor}"/>
                                                            <TextBlock Text="아이템" Foreground="{StaticResource AccentColor}"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource SecondaryButton}"
                                                            HorizontalAlignment="Stretch"
                                                            Command="{Binding DataContext.OpenSessionsCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <iconPacks:PackIconMaterial Kind="ClipboardText" Width="12" Height="12" Margin="0,0,4,0"/>
                                                            <TextBlock Text="세션"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>

                                            <Grid Grid.Row="2" Margin="12,0,12,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Style="{StaticResource SecondaryButton}"
                                                        HorizontalAlignment="Stretch"
                                                        FontSize="10"
                                                        Command="{Binding DataContext.RenameMonsterCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <iconPacks:PackIconMaterial Kind="Pencil" Width="10" Height="10" Margin="0,0,4,0"/>
                                                        <TextBlock Text="이름변경"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource DangerButton}"
                                                        HorizontalAlignment="Stretch"
                                                        FontSize="10"
                                                        Command="{Binding DataContext.DeleteMonsterCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <iconPacks:PackIconMaterial Kind="Delete" Width="10" Height="10" Margin="0,0,4,0"/>
                                                        <TextBlock Text="삭제"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>