<Window x:Class="GersangTracker.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="사냥 결과" Height="600" Width="550"
        Background="#222831"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- 상단 헤더 -->
        <Border Grid.Row="0" Background="#393E46">
            <Grid Margin="16,0">
                <TextBlock Text="사냥 결과"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding MonsterName}"
                           Foreground="#00ADB5"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- 컬럼 헤더 -->
        <Grid Grid.Row="1" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="아이템명"
                       Foreground="#EEEEEE"
                       Opacity="0.6"
                       FontSize="11"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="수량"
                       Foreground="#EEEEEE"
                       Opacity="0.6"
                       FontSize="11"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2"
                       Text="단가"
                       Foreground="#EEEEEE"
                       Opacity="0.6"
                       FontSize="11"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="3"
                       Text="합계"
                       Foreground="#EEEEEE"
                       Opacity="0.6"
                       FontSize="11"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
        </Grid>

        <!-- 아이템 목록 -->
        <ScrollViewer Grid.Row="2" Margin="8,0">
            <ItemsControl ItemsSource="{Binding PriceItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#393E46"
                                CornerRadius="4"
                                Margin="8,4"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <!-- 아이템명 -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding ItemName}"
                                           Foreground="White"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                <!-- 수량 -->
                                <TextBlock Grid.Column="1"
                                           Foreground="#EEEEEE"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center">
                                    <Run Text="{Binding TotalQuantity}"/>
                                    <Run Text="개"/>
                                </TextBlock>

                                <!-- 단가 -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                           Foreground="#EEEEEE"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>

                                <!-- 합계 -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Total, StringFormat={}{0:N0}}"
                                           Foreground="#00ADB5"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 수익 요약 -->
        <Border Grid.Row="3" Background="#393E46" Margin="8,4">
            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 총 수익 -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="총 수익"
                           Foreground="#EEEEEE"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding TotalProfit, StringFormat={}{0:N0} 원}"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <!-- 사냥 시간 -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="사냥 시간"
                           Foreground="#EEEEEE"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding HuntingTime}"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <!-- 시간당 수익 -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="시간당 수익"
                           Foreground="#EEEEEE"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding ProfitPerHour, StringFormat={}{0:N0} 원/h}"
                           Foreground="#00ADB5"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 하단 버튼 -->
        <Border Grid.Row="4" Background="#393E46">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button Content="엑셀 내보내기"
                        Width="140"
                        Height="36"
                        Background="#393E46"
                        Foreground="White"
                        BorderThickness="1"
                        BorderBrush="#00ADB5"
                        Cursor="Hand"
                        FontSize="12"
                        Margin="0,0,12,0"
                        Command="{Binding ExportExcelCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="확인"
                        Width="140"
                        Height="36"
                        Background="#00ADB5"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontSize="12"
                        Click="ConfirmButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>