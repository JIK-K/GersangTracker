<Window x:Class="GersangTracker.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GersangTracker.Views"
        mc:Ignorable="d"
        Title="이름 변경" Height="200" Width="360"
        Background="#222831"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 라벨 -->
        <TextBlock Grid.Row="0"
                   Text="새 몬스터 이름"
                   Foreground="#EEEEEE"
                   FontSize="12"
                   Margin="0,0,0,8"/>

        <!-- 입력창 -->
        <TextBox x:Name="NameInput"
                 Grid.Row="1"
                 Height="36"
                 Padding="10,8"
                 Background="#393E46"
                 Foreground="White"
                 BorderThickness="0"
                 CaretBrush="White"
                 FontSize="13"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,16">
            <TextBox.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </TextBox.Resources>
        </TextBox>

        <!-- 버튼 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="취소"
                    Height="36"
                    Background="#393E46"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CancelButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Column="2"
                    Content="확인"
                    Height="36"
                    Background="#00ADB5"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="ConfirmButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>
