<Window x:Class="GersangTracker.Views.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="세션 목록" Height="540" Width="620"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AnimatedWindowStyle}">

    <Border Background="{StaticResource BackgroundPrimary}" CornerRadius="12"
            BorderBrush="{StaticResource BackgroundSecondary}" BorderThickness="1">
        <Border.Effect>
            <StaticResource ResourceKey="SoftDropShadow"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 커스텀 타이틀바 -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundSecondary}" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#00ADB5" Margin="0,0,8,0"/>
                        <TextBlock Text="세션 목록" Foreground="White" FontSize="13"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click">
                            <Path Data="M 8,12 L 24,12" Stroke="#EEEEEE" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click">
                            <Path Data="M 8,8 L 22,22 M 22,8 L 8,22" Stroke="#EEEEEE" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 헤더 -->
            <Border Grid.Row="1" Background="{StaticResource BackgroundSecondary}" Margin="12,0,12,0" CornerRadius="8">
                <Grid Margin="16,0">
                    <TextBlock Text="세션 목록" Foreground="{StaticResource TextPrimary}" FontSize="15"
                               FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MonsterName}" Foreground="{StaticResource AccentColor}"
                               FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- 컬럼 헤더 -->
            <Grid Grid.Row="2" Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="날짜" Foreground="{StaticResource TextSecondary}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="사냥 시간" Foreground="{StaticResource TextSecondary}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="총 수익" Foreground="{StaticResource TextSecondary}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- 세션 목록 -->
            <ScrollViewer Grid.Row="3" Margin="8,0,8,8">
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" Margin="8,0" Padding="12,12"
                                    BorderBrush="{StaticResource SeparatorColor}" BorderThickness="0,0,0,1"
                                    Cursor="Hand" MouseLeftButtonDown="Session_MouseLeftButtonDown">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                               Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding HuntingTimeDisplay}"
                                               Foreground="{StaticResource TextSecondary}" FontSize="13"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TotalProfit, StringFormat={}{0:N0} 원}"
                                               Foreground="{StaticResource AccentColor}" FontSize="13" FontWeight="Bold"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <Button Grid.Column="3"
                                            Style="{StaticResource DangerButton}"
                                            FontSize="11" Padding="8,4" HorizontalAlignment="Center"
                                            Command="{Binding DataContext.DeleteSessionCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="Delete" Width="10" Height="10" Margin="0,0,4,0"/>
                                            <TextBlock Text="삭제"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>