<Window x:Class="GersangTracker.Views.AccountSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="계정 설정" Height="340" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource AnimatedWindowStyle}"
        Background="{StaticResource BackgroundPrimary}">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="계정 설정" FontSize="18" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="아이디" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
            <TextBox Text="{Binding UserId}" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,12"/>

            <TextBlock Text="비밀번호" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
            <TextBox Text="{Binding Password}" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,12"/>

            <TextBlock Text="클라이언트 경로" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding ClientPath}" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="찾아보기" Height="36" Style="{StaticResource SecondaryButton}" 
                        Command="{Binding BrowseClientPathCommand}"/>
            </Grid>

            <!-- 삭제, 취소, 저장 버튼 그룹 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- 삭제 버튼 -->
                    <ColumnDefinition Width="*"/>
                    <!-- 빈 공간 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 취소 버튼 -->
                    <ColumnDefinition Width="10"/>
                    <!-- 여백 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 저장 버튼 -->
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="삭제" Width="70" Height="36" Style="{StaticResource DangerButton}" 
                        Command="{Binding DeleteAccountCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

                <Button Grid.Column="2" Content="취소" Width="70" Height="36" Style="{StaticResource SecondaryButton}" 
                        Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

                <Button Grid.Column="4" Content="저장" Width="70" Height="36" Style="{StaticResource PrimaryButton}" 
                        Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>