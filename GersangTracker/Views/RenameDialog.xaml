<Window x:Class="GersangTracker.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GersangTracker.Views"
        mc:Ignorable="d"
        Title="이름 변경" Height="200" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource AnimatedWindowStyle}">

    <Border Background="{StaticResource BackgroundSecondary}" CornerRadius="12"
            BorderBrush="{StaticResource BackgroundTertiary}" BorderThickness="1">
        <Border.Effect>
            <StaticResource ResourceKey="SoftDropShadow"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 커스텀 타이틀바 -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundSecondary}" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="이름 변경" Foreground="{StaticResource TextPrimary}" FontSize="13"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                            Click="CancelButton_Click">
                        <Path Data="M 8,8 L 22,22 M 22,8 L 8,22" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 콘텐츠 -->
            <Grid Grid.Row="1" Margin="20,16,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 레이블 -->
                <TextBlock Grid.Row="0"
                           Text="새 몬스터 이름"
                           Style="{StaticResource SectionHeaderLabel}"
                           Margin="0,0,0,8"/>

                <!-- 입력창 -->
                <TextBox x:Name="NameInput"
                         Grid.Row="1"
                         Style="{StaticResource ModernTextBox}"
                         Height="38"
                         Margin="0,0,0,16"/>

                <!-- 버튼 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource SecondaryButton}"
                            Height="36"
                            Click="CancelButton_Click">
                        <TextBlock Text="취소"/>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButton}"
                            Height="36"
                            Click="ConfirmButton_Click">
                        <TextBlock Text="확인"/>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>