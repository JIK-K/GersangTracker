<Window x:Class="GersangTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GersangTracker.ViewModels"
        Title="GersangTracker" Height="700" Width="1000"
        Background="#222831">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- 카드 스타일 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#393E46"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="160"/>
        </Style>

        <!-- 기본 버튼 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#00ADB5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 사이드바 버튼 -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="#00ADB5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 사이드바 -->
        <Border Grid.Column="0" Background="#393E46">
            <StackPanel Margin="16">

                <!-- 타이틀 -->
                <TextBlock Text="GersangTracker"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,16,0,32"/>

                <!-- 몬스터 추가 라벨 -->
                <TextBlock Text="몬스터 추가"
                           Foreground="#EEEEEE"
                           Opacity="0.6"
                           FontSize="11"
                           Margin="0,0,0,6"/>

                <!-- 몬스터 이름 입력 -->
                <TextBox Height="36"
                         Padding="10,8"
                         Background="#222831"
                         Foreground="White"
                         BorderThickness="0"
                         CaretBrush="White"
                         Text="{Binding NewMonsterName, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,8">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button Content="+ 추가"
                        Style="{StaticResource SidebarButton}"
                        Command="{Binding AddMonsterCommand}"/>
            </StackPanel>
        </Border>

        <!-- 메인 컨텐츠 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 상단 타이틀 -->
            <Border Grid.Row="0" Background="#222831">
                <TextBlock Text="몬스터 목록"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="24,0"/>
            </Border>

            <!-- 카드 목록 -->
            <ScrollViewer Grid.Row="1" Margin="16">
                <ItemsControl ItemsSource="{Binding Monsters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 몬스터 이름 -->
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Name}"
                                               Foreground="White"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"/>

                                    <!-- 사냥 시작 버튼 -->
                                    <Button Grid.Row="1"
                                            Content="사냥 시작"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,8,0,6"
                                            Command="{Binding DataContext.StartHuntingCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>

                                    <!-- 이름변경 / 삭제 -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Content="이름변경"
                                                Style="{StaticResource PrimaryButton}"
                                                Background="#393E46"
                                                HorizontalAlignment="Stretch"
                                                FontSize="11"
                                                Command="{Binding DataContext.RenameMonsterCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Grid.Column="2"
                                                Content="삭제"
                                                Style="{StaticResource PrimaryButton}"
                                                Background="#C0392B"
                                                HorizontalAlignment="Stretch"
                                                FontSize="11"
                                                Command="{Binding DataContext.DeleteMonsterCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>