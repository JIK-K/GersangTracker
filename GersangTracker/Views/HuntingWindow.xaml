<Window x:Class="GersangTracker.Views.HuntingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="사냥 중" Height="540" Width="500"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Border Background="#222831" CornerRadius="10"
            BorderBrush="#393E46" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="20" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>

            <!-- 커스텀 타이틀바 -->
            <Border Grid.Row="0" Background="#222831" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#00ADB5" Margin="0,0,8,0"/>
                        <TextBlock Text="사냥 중" Foreground="White" FontSize="13"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Width="40" Height="32" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="MinimizeButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                        <Path Data="M 8,12 L 24,12" Stroke="#EEEEEE" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#393E46"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="40" Height="32" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                        <Path Data="M 8,8 L 22,22 M 22,8 L 8,22" Stroke="#EEEEEE" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#C0392B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 헤더: 몬스터명 + 경과시간 -->
            <Border Grid.Row="1" Background="#393E46" Margin="12,0,12,0" CornerRadius="6">
                <Grid Margin="16,0">
                    <TextBlock Text="{Binding CurrentMonster.Name}"
                               Foreground="White" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="경과 시간" Foreground="#EEEEEE" Opacity="0.6"
                                   FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ElapsedTime}" Foreground="#00ADB5"
                                   FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 드랍 로그 -->
            <Border Grid.Row="2" Background="#393E46" Margin="12,8,12,4" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#2D3139" CornerRadius="6,6,0,0">
                        <TextBlock Text="드랍 로그" Foreground="#EEEEEE" FontSize="11"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" Margin="8,4">
                        <ItemsControl ItemsSource="{Binding DropLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DroppedAt, StringFormat=HH:mm:ss}"
                                                   Foreground="#EEEEEE" Opacity="0.6"
                                                   FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ItemName}"
                                                   Foreground="White" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Foreground="#00ADB5"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right">
                                            <Run Text="x"/><Run Text="{Binding Quantity}"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="#2D3139" CornerRadius="0,0,6,6">
                        <ScrollViewer MaxHeight="48" Margin="8,4">
                            <ItemsControl ItemsSource="{Binding StatusLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Mode=OneWay}"
                                                 Foreground="#EEEEEE" Background="Transparent"
                                                 BorderThickness="0" IsReadOnly="True"
                                                 FontSize="10" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- 아이템 합산 -->
            <Border Grid.Row="3" Background="#393E46" Margin="12,4,12,8" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#2D3139" CornerRadius="6,6,0,0">
                        <TextBlock Text="아이템 합산" Foreground="#EEEEEE" FontSize="11"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" Margin="8,4">
                        <ItemsControl ItemsSource="{Binding ItemSummaries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2D3139" CornerRadius="4" Padding="8,4" Margin="4,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ItemName}" Foreground="White"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Foreground="#00ADB5" FontSize="11"
                                                       Margin="6,0,0,0" VerticalAlignment="Center">
                                                <Run Text="x"/><Run Text="{Binding TotalQuantity}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 사냥 종료 버튼 -->
            <Border Grid.Row="4" Background="#393E46" CornerRadius="0,0,10,10">
                <Button Content="⚔ 사냥 종료" Width="160" Height="34"
                        Background="#C0392B" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        FontSize="13" FontWeight="Bold"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Click="StopHunting_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>