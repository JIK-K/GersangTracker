<Window x:Class="GersangTracker.Views.HuntingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="사냥 중" Height="560" Width="500"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AnimatedWindowStyle}">

    <Border Background="{StaticResource BackgroundSecondary}" CornerRadius="12"
            BorderBrush="{StaticResource BackgroundTertiary}" BorderThickness="1">
        <Border.Effect>
            <StaticResource ResourceKey="SoftDropShadow"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <!-- 커스텀 타이틀바 -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundSecondary}" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="사냥 중" Foreground="{StaticResource TextPrimary}" FontSize="13"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click">
                            <Path Data="M 8,12 L 24,12" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click">
                            <Path Data="M 8,8 L 22,22 M 22,8 L 8,22" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 헤더: 몬스터명 + 경과 시간 -->
            <Border Grid.Row="1" Background="{StaticResource AccentGradient}"
                    Margin="12,0,12,0" CornerRadius="8">
                <Grid Margin="16,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="HUNTING NOW"
                                   Foreground="White" Opacity="0.7" FontSize="10" FontWeight="Bold"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding CurrentMonster.Name}"
                                   Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                    <!-- 경과 시간 배지 -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="#22000000" CornerRadius="6" Padding="10,6">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="경과 시간" Foreground="White" Opacity="0.7"
                                       FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ElapsedTime}" Foreground="White"
                                       FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 드랍 로그 -->
            <Border Grid.Row="2" Background="{StaticResource BackgroundPrimary}"
                    Margin="12,8,12,4" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 섹션 헤더 -->
                    <Border Grid.Row="0" Background="{StaticResource BackgroundTertiary}" CornerRadius="8,8,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                            <iconPacks:PackIconMaterial Kind="History" Width="11" Height="11"
                                                        Foreground="{StaticResource AccentColor}"
                                                        Margin="0,0,6,0"/>
                            <TextBlock Text="드랍 로그" Style="{StaticResource PanelTitle}"/>
                        </StackPanel>
                    </Border>

                    <!-- 로그 목록 -->
                    <ScrollViewer Grid.Row="1" Margin="8,4">
                        <ItemsControl ItemsSource="{Binding DropLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DroppedAt, StringFormat=HH:mm:ss}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ItemName}"
                                                   Foreground="{StaticResource TextPrimary}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Foreground="{StaticResource AccentColor}"
                                                   FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right">
                                            <Run Text="x"/><Run Text="{Binding Quantity}"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 상태 로그 -->
                    <Border Grid.Row="2" Background="{StaticResource BackgroundTertiary}" CornerRadius="0,0,8,8">
                        <ScrollViewer MaxHeight="48" Margin="8,4">
                            <ItemsControl ItemsSource="{Binding StatusLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Mode=OneWay}"
                                                 Foreground="{StaticResource TextSecondary}"
                                                 Background="Transparent"
                                                 BorderThickness="0" IsReadOnly="True"
                                                 FontSize="10" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- 아이템 합산 -->
            <Border Grid.Row="3" Background="{StaticResource BackgroundPrimary}"
                    Margin="12,4,12,8" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource BackgroundTertiary}" CornerRadius="8,8,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                            <iconPacks:PackIconMaterial Kind="PackageVariant" Width="11" Height="11"
                                                        Foreground="{StaticResource AccentColor}"
                                                        Margin="0,0,6,0"/>
                            <TextBlock Text="아이템 합산" Style="{StaticResource PanelTitle}"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" Margin="8,6">
                        <ItemsControl ItemsSource="{Binding ItemSummaries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundTertiary}"
                                            CornerRadius="5" Padding="8,4" Margin="3,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ItemName}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Foreground="{StaticResource AccentColor}" FontSize="11"
                                                       FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <Run Text="x"/><Run Text="{Binding TotalQuantity}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 사냥 종료 버튼 -->
            <Border Grid.Row="4" Background="{StaticResource BackgroundTertiary}" CornerRadius="0,0,12,12"
                    BorderBrush="{StaticResource SeparatorColor}" BorderThickness="0,1,0,0">
                <Button Style="{StaticResource DangerButton}"
                        Width="160" Height="36"
                        FontSize="13"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Click="StopHunting_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Stop" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="사냥 종료"/>
                    </StackPanel>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>