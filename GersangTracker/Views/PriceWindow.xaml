<Window x:Class="GersangTracker.Views.PriceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="가격 입력" Height="600" Width="500"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Border Background="#222831" CornerRadius="10"
            BorderBrush="#393E46" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="20" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>

            <!-- 커스텀 타이틀바 -->
            <Border Grid.Row="0" Background="#222831" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#00ADB5" Margin="0,0,8,0"/>
                        <TextBlock Text="가격 입력" Foreground="White" FontSize="13"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Width="40" Height="32" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="MinimizeButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                        <Path Data="M 8,12 L 24,12" Stroke="#EEEEEE" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#393E46"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="40" Height="32" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                        <Path Data="M 8,8 L 22,22 M 22,8 L 8,22" Stroke="#EEEEEE" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#C0392B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 헤더 -->
            <Border Grid.Row="1" Background="#393E46" Margin="12,0,12,0" CornerRadius="6">
                <Grid Margin="16,0">
                    <TextBlock Text="가격 입력" Foreground="White" FontSize="15"
                               FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MonsterName}" Foreground="#00ADB5"
                               FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- 컬럼 헤더 -->
            <Grid Grid.Row="2" Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="아이템명" Foreground="#EEEEEE"
                           Opacity="0.5" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="수량" Foreground="#EEEEEE"
                           Opacity="0.5" FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="단가 (원)" Foreground="#EEEEEE"
                           Opacity="0.5" FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Grid>

            <!-- 아이템 목록 -->
            <ScrollViewer Grid.Row="3" Margin="8,0">
                <ItemsControl ItemsSource="{Binding PriceItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#393E46" CornerRadius="4" Margin="8,3" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ItemName}"
                                               Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding TotalQuantity, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#2D3139" Foreground="White" BorderThickness="0"
                                             CaretBrush="White" FontSize="12" Padding="4"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding UnitPriceInput, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#2D3139" Foreground="White" BorderThickness="0"
                                             CaretBrush="White" FontSize="12" Padding="8,4"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Right">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                    <Button Grid.Column="3" Content="✕"
                                            Command="{Binding DataContext.RemoveItemCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" Foreground="#C0392B"
                                            BorderThickness="0" FontSize="12" Padding="4"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 아이템 추가 -->
            <Grid Grid.Row="4" Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,0,8,0"
                         Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}"
                         Background="#393E46" Foreground="White"
                         BorderBrush="#00ADB5" BorderThickness="1"
                         CaretBrush="White" Padding="6,4" FontSize="12">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </TextBox.Resources>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddItemCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBox Grid.Column="1" Margin="0,0,8,0"
                         Text="{Binding NewItemQuantity, UpdateSourceTrigger=PropertyChanged}"
                         Background="#393E46" Foreground="White"
                         BorderBrush="#00ADB5" BorderThickness="1"
                         CaretBrush="White" Padding="6,4" FontSize="12"
                         HorizontalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </TextBox.Resources>
                </TextBox>
                <Button Grid.Column="2" Content="+ 추가"
                        Command="{Binding AddItemCommand}"
                        Background="#00ADB5" Foreground="White"
                        BorderThickness="0" Padding="12,4" FontSize="12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 계산하기 버튼 -->
            <Border Grid.Row="5" Background="#393E46" CornerRadius="0,0,10,10">
                <Button Content="계산하기" Width="160" Height="34"
                        Background="#00ADB5" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        FontSize="13" FontWeight="Bold"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Click="CalculateButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>