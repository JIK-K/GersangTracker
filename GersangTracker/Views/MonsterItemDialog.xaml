<!-- Views/MonsterItemDialog.xaml -->
<Window x:Class="GersangTracker.Views.MonsterItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="드랍 아이템 관리" Height="420" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#222831">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 타이틀 -->
            <RowDefinition Height="Auto"/>
            <!-- 입력부 -->
            <RowDefinition Height="*"/>
            <!-- 목록 -->
            <RowDefinition Height="Auto"/>
            <!-- 닫기 버튼 -->
        </Grid.RowDefinitions>

        <!-- 타이틀 -->
        <TextBlock Grid.Row="0" Margin="0,0,0,16"
                   Text="{Binding MonsterName, StringFormat='{}{0} — 드랍 아이템 목록'}"
                   Foreground="#00ADB5" FontSize="15" FontWeight="Bold"/>

        <!-- 입력부 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Margin="0,0,8,0"
                     Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}"
                     Background="#393E46" Foreground="White" BorderBrush="#00ADB5"
                     Padding="6,4" FontSize="13"
                     x:Name="ItemInput">
                <!-- 엔터키 지원 -->
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding AddItemCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="+ 추가"
                    Command="{Binding AddItemCommand}"
                    Background="#00ADB5" Foreground="White"
                    BorderThickness="0" Padding="12,4" FontSize="13"/>
        </Grid>

        <!-- 아이템 목록 -->
        <Border Grid.Row="2" Background="#393E46" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ItemName}"
                                           Foreground="#EEEEEE" FontSize="13"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="✕"
                                        Command="{Binding DataContext.DeleteItemCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" Foreground="#C0392B"
                                        BorderThickness="0" FontSize="12" Padding="6,2"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 닫기 버튼 -->
        <Button Grid.Row="3" Content="닫기" Margin="0,16,0,0"
                HorizontalAlignment="Right" Padding="20,6"
                Background="#393E46" Foreground="White" BorderThickness="0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>